{
  "name": "ks-solar-energy",
  "version": "1.0.31",
  "main": "App.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build && node -e \"const fs = require('fs'); const html = fs.readFileSync('dist/index.html', 'utf8'); fs.writeFileSync('embeddedHtml.js', 'export const embeddedHtml = ' + JSON.stringify(html) + ';\\n');\"",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "export:apk": "npx eas-cli build --platform android --profile preview",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "expo": "~52.0.37",
    "expo-location": "^57.0.20",
    "expo-status-bar": "~2.0.1",
    "expo-task-manager": "^57.0.20",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.7",
    "react-native-webview": "13.12.5",
    "resend": "^6.30.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
